# Optional local POC runner. Builds execute trusted repository code.
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV ASTRO_TELEMETRY_DISABLED=1
WORKDIR /app
COPY api/requirements.txt /app/api/requirements.txt
RUN pip install --no-cache-dir -r api/requirements.txt
COPY tools/package*.json /app/tools/
RUN npm ci --prefix tools && ./tools/node_modules/.bin/playwright install --with-deps chromium
COPY demo-site/package*.json /app/demo-site/
RUN npm ci --prefix demo-site
COPY api/ /app/api/
COPY tools/ /app/tools/
COPY demo-site/ /app/demo-site/
COPY scenarios/ /app/scenarios/
COPY knowledge/ /app/knowledge/
RUN mkdir -p /app/data
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
