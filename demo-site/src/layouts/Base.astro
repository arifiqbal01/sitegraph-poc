---
const { title, description = "Northstar brings client projects, delivery workflows and reporting into one workspace for independent teams.", robots = "index,follow" } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://northstar.example');
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} | Northstar</title><meta name="description" content={description}/><meta name="robots" content={robots}/><link rel="canonical" href={canonical}/>
<style is:global>
:root{font-family:Inter,system-ui,sans-serif;color:#192b3a;background:#f7f8fa;font-size:17px;line-height:1.65}*{box-sizing:border-box}body{margin:0}a{color:#174c98;text-underline-offset:4px}a:hover{color:#123764}a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #9c4610;outline-offset:5px}.wrap,main{max-width:1120px;margin:auto;padding:24px}header{background:white;border-bottom:1px solid #d9e0e6}header .wrap{display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-weight:850;font-size:26px;text-decoration:none;color:#192b3a}nav{display:flex;gap:24px;flex-wrap:wrap}main{padding-top:64px;padding-bottom:80px}h1{font-size:clamp(2.2rem,5vw,3.7rem);line-height:1.12;letter-spacing:-.04em;max-width:850px;margin:0 0 24px}h2{line-height:1.25;font-size:1.6rem}h3{line-height:1.3}p{max-width:75ch}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.75rem;font-weight:800;color:#475b6f}.lead{font-size:1.25rem;color:#425568;max-width:64ch}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;margin:36px 0}.card,section.plan{background:white;border:1px solid #d9e0e6;border-radius:16px;padding:28px}.card h2,.card h3{margin-top:0}.button{display:inline-block;background:#174c98;color:white;text-decoration:none;font-weight:700;padding:12px 22px;border-radius:8px}.button:hover{background:#123764;color:white}.price{font-size:2.4rem;font-weight:800}.muted{color:#425568}section{margin:40px 0}table{width:100%;border-collapse:collapse;background:white}th,td{text-align:left;padding:15px;border-bottom:1px solid #d9e0e6}.table-wrap{overflow:auto}details{background:white;padding:20px;margin:14px 0;border:1px solid #d9e0e6;border-radius:10px}summary{cursor:pointer;font-weight:700}footer{background:#192b3a;color:#fff}footer a{color:#c9dfff}footer .wrap{padding:36px 24px}.skip{position:absolute;left:-9999px}.skip:focus{left:16px;top:10px;background:white;padding:12px;z-index:10}@media(max-width:650px){header .wrap{align-items:flex-start;flex-direction:column}nav{gap:14px}main{padding-top:38px}th,td{padding:10px}}
</style></head><body><a class="skip" href="#main">Skip to content</a><header><div class="wrap"><a class="brand" href="/">Northstar<span aria-hidden="true"> ↗</span></a><nav aria-label="Main navigation"><a href="/pricing">Pricing</a><a href="/services">Services</a><a href="/integrations">Integrations</a><a href="/resources">Resources</a><a href="/faq">FAQ</a></nav></div></header>
<main id="main"><slot/></main><footer><div class="wrap"><strong>Northstar · A clearer way to deliver.</strong><p>Fictional company and illustrative product data for the SiteGraph demonstration. No live billing or customer accounts.</p><a href="/privacy">Privacy &amp; data</a> · <a href="/contact">Contact &amp; support</a></div></footer></body></html>
